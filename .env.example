# Database Connection string for Neon Serverless PostgreSQL
# Get your free connection string from https://neon.tech (e.g., postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# Server Port
PORT=3000

# Environment Mode (development / production)
NODE_ENV=development

# JWT Secret for cryptographic token signing (e.g. generate via openssl rand -hex 32)
JWT_SECRET=your_super_secret_64_character_hex_key_here



